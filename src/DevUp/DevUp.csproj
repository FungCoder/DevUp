<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>DevUp</AssemblyName>
    <RootNamespace>DevUp</RootNamespace>
    <Version>1.1.1</Version>
    <Product>DevUp 驱动与软件更新助手</Product>
    <AssemblyTitle>DevUp</AssemblyTitle>
    <Company>风之翼灵'Blog</Company>
    <Copyright>© 2026 风之翼灵'Blog (www.fungj.com). 保留所有权利。</Copyright>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Description>组合 PSWindowsUpdate / Nefarius.Utilities.DeviceManagement / winget / pnputil 的驱动与软件更新工具</Description>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <UseWindowsForms>false</UseWindowsForms>

    <!-- 发布：单个 exe，使用官方 .NET 8 桌面运行时，不随包释放原生运行时 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DevUp.PortableTests" />
    <!-- 应用图标（exe 图标由 ApplicationIcon 指定；这里作为 WPF 资源供界面使用） -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 复用：SetupAPI / CfgMgr32 / DriverStore 的 .NET 封装 (MIT, Nefarius) -->
    <PackageReference Include="Nefarius.Utilities.DeviceManagement" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 复用：PowerShell 后端脚本（内嵌，运行时释放） -->
    <EmbeddedResource Include="Scripts\devup.ps1" LogicalName="devup.ps1" />
    <!-- 仅嵌入 PowerShell 5.1 导入所需文件；NuGet 元数据和帮助文档不参与运行 -->
    <EmbeddedResource Include="..\..\lib\PSWindowsUpdate\**\*"
                      Exclude="..\..\lib\PSWindowsUpdate\package\**\*;..\..\lib\PSWindowsUpdate\_rels\**\*;..\..\lib\PSWindowsUpdate\*.xml;..\..\lib\PSWindowsUpdate\*.nuspec;..\..\lib\PSWindowsUpdate\*.tmp">
      <LogicalName>PSWindowsUpdate/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- MSCatalog 保留两套运行时程序集，只排除 NuGet 打包元数据 -->
    <EmbeddedResource Include="..\..\lib\MSCatalog\**\*"
                      Exclude="..\..\lib\MSCatalog\package\**\*;..\..\lib\MSCatalog\_rels\**\*;..\..\lib\MSCatalog\*.xml;..\..\lib\MSCatalog\*.nuspec">
      <LogicalName>MSCatalog/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
