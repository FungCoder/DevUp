<Window x:Class="DevUp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DevUp.Views"
        Title="DevUp · 驱动与软件更新助手"
        Icon="Assets/app.ico"
        Width="1380" Height="860" MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ 侧栏 ============ -->
        <Border Grid.Column="0" Background="{StaticResource SideBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="24,28,20,24">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentBrush}">
                            <Path Data="M4,4 L12,4 C17,4 20,7 20,12 C20,17 17,20 12,20 L4,20 Z M9,9 L12,9 C14,9 15,10 15,12 C15,14 14,15 12,15 L9,15 Z"
                                  Fill="White" Stretch="Uniform" Width="22" Height="22"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DevUp" Foreground="White" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="设备与软件管理" Foreground="#91A1BE" FontSize="10.5" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="工作空间" Foreground="#657692" FontSize="10.5" FontWeight="SemiBold"
                               Margin="26,0,0,10" />
                    <ToggleButton x:Name="NavDashboard" Style="{StaticResource NavButton}"
                                  Tag="{StaticResource IconDashboard}"
                                  Content="概览" Checked="Nav_Checked" />
                    <ToggleButton x:Name="NavDrivers" Style="{StaticResource NavButton}"
                                  Tag="{StaticResource IconDrivers}"
                                  Content="驱动与设备" Checked="Nav_Checked" />
                    <ToggleButton x:Name="NavSoftware" Style="{StaticResource NavButton}"
                                  Tag="{StaticResource IconSoftware}"
                                  Content="软件更新" Checked="Nav_Checked" />
                    <ToggleButton x:Name="NavNpm" Style="{StaticResource NavButton}"
                                  Tag="{StaticResource IconNpm}"
                                  Content="Node.js 包" Checked="Nav_Checked" />
                    <Border Height="1" Background="#25334B" Margin="25,18,25,18" />
                    <TextBlock Text="系统工具" Foreground="#657692" FontSize="10.5" FontWeight="SemiBold"
                               Margin="26,0,0,10" />
                    <ToggleButton x:Name="NavTools" Style="{StaticResource NavButton}"
                                  Tag="{StaticResource IconTools}"
                                  Content="备份与工具" Checked="Nav_Checked" />
                </StackPanel>

                <Border Grid.Row="2" BorderBrush="#28354C" BorderThickness="0,1,0,0" Padding="22,16">
                    <StackPanel>
                        <TextBlock x:Name="AdminBadge" Text="权限：普通用户" Foreground="#A4B2CC" FontSize="11.5" />
                        <Button x:Name="BtnElevate" Content="以管理员身份重新启动"
                                Visibility="Collapsed" Style="{StaticResource GhostButton}"
                                Foreground="#B8C5F7" BorderBrush="#354765" Margin="0,10,0,0"
                                Padding="8,4" FontSize="11.5" Click="BtnElevate_Click" />
                        <TextBlock x:Name="BuildInfo" Foreground="#73829F" FontSize="10.5" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ 主区 ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,1" Padding="30,21">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DEVUP / WORKSPACE" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4" />
                        <TextBlock x:Name="PageTitle" Text="概览" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="PageSubtitle" Text="" FontSize="12.5"
                                   Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnRescan" Content="重新扫描设备" Style="{StaticResource GhostButton}"
                                Click="BtnRescan_Click" />
                        <Button x:Name="BtnScanUpdates" Content="检查全部更新" Style="{StaticResource PrimaryButton}"
                                Margin="10,0,0,0" Click="BtnScanUpdates_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="PageHost" Grid.Row="1" Margin="28,22,28,0" />

            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ProgressBar x:Name="BusyBar" Grid.Row="0" Height="2.5" IsIndeterminate="True"
                                 Visibility="Collapsed" Foreground="{StaticResource AccentBrush}" Background="Transparent" />
                    <Grid Grid.Row="1" Margin="30,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StatusText" Text="就绪" FontSize="11.5" Foreground="{StaticResource SubTextBrush}" />
                            <TextBlock x:Name="ScanTimeText" Text="" FontSize="11.5" Foreground="{StaticResource SubTextBrush}"
                                       Margin="16,0,0,0" />
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right" FontSize="11.5" Foreground="{StaticResource SubTextBrush}"
                                   Cursor="Hand" MouseLeftButtonUp="BtnBlog_Click" ToolTip="访问作者博客"
                                   Text="DevUp  ·  www.fungj.com" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
