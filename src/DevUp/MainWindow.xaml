<Window x:Class="DevUp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DevUp.Views"
        Title="DevUp · 驱动与软件更新助手"
        Icon="Assets/app.ico"
        Width="1220" Height="790" MinWidth="1020" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ 侧栏 ============ -->
        <Border Grid.Column="0" Background="{StaticResource SideBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,22,16,20">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="8" Background="White">
                            <Image Source="Assets/app.ico" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="DevUp" Foreground="White" FontSize="16.5" FontWeight="SemiBold" />
                            <TextBlock Text="驱动 · 软件更新助手" Foreground="#77839A" FontSize="10.5" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <ToggleButton x:Name="NavDashboard" Style="{StaticResource NavButton}" Tag="◉"
                                  Content="概览" Checked="Nav_Checked" />
                    <ToggleButton x:Name="NavDrivers" Style="{StaticResource NavButton}" Tag="▤"
                                  Content="驱动与设备" Checked="Nav_Checked" />
                    <ToggleButton x:Name="NavSoftware" Style="{StaticResource NavButton}" Tag="◧"
                                  Content="软件更新" Checked="Nav_Checked" />
                    <ToggleButton x:Name="NavNpm" Style="{StaticResource NavButton}" Tag="⬢"
                                  Content="Node.js 包" Checked="Nav_Checked" />
                    <ToggleButton x:Name="NavTools" Style="{StaticResource NavButton}" Tag="⚙"
                                  Content="备份与工具" Checked="Nav_Checked" />
                </StackPanel>

                <Border Grid.Row="2" BorderBrush="#2A3140" BorderThickness="0,1,0,0" Padding="18,11">
                    <StackPanel>
                        <TextBlock x:Name="AdminBadge" Text="权限：普通用户" Foreground="#8A94A6" FontSize="11.5" />
                        <Button x:Name="BtnElevate" Content="以管理员身份重新启动"
                                Visibility="Collapsed" Style="{StaticResource GhostButton}"
                                Foreground="#9FB4E8" BorderBrush="#39445A" Margin="0,8,0,0"
                                Padding="8,4" FontSize="11.5" Click="BtnElevate_Click" />
                        <TextBlock x:Name="BuildInfo" Foreground="#5E6879" FontSize="10.5" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ 主区 ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,13">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="概览" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="PageSubtitle" Text="" FontSize="11.5" Foreground="{StaticResource SubTextBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnRescan" Content="重新扫描" Style="{StaticResource GhostButton}" Click="BtnRescan_Click" />
                        <Button x:Name="BtnScanUpdates" Content="检查更新" Style="{StaticResource PrimaryButton}"
                                Margin="8,0,0,0" Click="BtnScanUpdates_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="PageHost" Grid.Row="1" Margin="22,16,22,0" />

            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ProgressBar x:Name="BusyBar" Grid.Row="0" Height="2.5" IsIndeterminate="True"
                                 Visibility="Collapsed" Foreground="{StaticResource AccentBrush}" Background="Transparent" />
                    <Grid Grid.Row="1" Margin="24,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StatusText" Text="就绪" FontSize="11.5" Foreground="{StaticResource SubTextBrush}" />
                            <TextBlock x:Name="ScanTimeText" Text="" FontSize="11.5" Foreground="{StaticResource SubTextBrush}"
                                       Margin="16,0,0,0" />
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right" FontSize="11.5" Foreground="{StaticResource SubTextBrush}"
                                   Cursor="Hand" MouseLeftButtonUp="BtnBlog_Click" ToolTip="访问作者博客"
                                   Text="© 2026 风之翼灵'Blog · www.fungj.com" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
