<UserControl x:Class="DevUp.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 状态标签：正常=绿，异常=红，未连接=灰 -->
        <DataTemplate x:Key="StatusCell">
            <Border x:Name="pill" CornerRadius="9" Padding="8,2" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Background="#EAF8EF">
                <TextBlock x:Name="txt" Text="{Binding ProblemText}" FontSize="11.5"
                           Foreground="#15803D" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ProblemCode}" Value="45">
                    <Setter TargetName="pill" Property="Background" Value="#F1F3F7" />
                    <Setter TargetName="txt" Property="Foreground" Value="#7B8794" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasProblem}" Value="True">
                    <Setter TargetName="pill" Property="Background" Value="#FDECEC" />
                    <Setter TargetName="txt" Property="Foreground" Value="#C62F2F" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarSurface}">
            <WrapPanel Orientation="Horizontal">
                <Button Content="刷新设备" Style="{StaticResource GhostButton}" Click="BtnRefresh_Click" />
                <Button Content="扫描驱动更新" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                        Click="BtnScanUpdates_Click" />
                <Button Content="启用 Microsoft Update 扩展源" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Click="BtnEnableMu_Click" ToolTip="注册 Microsoft Update 服务后可搜索显卡/网卡等第三方官方驱动（需要管理员）" />
                <Button Content="打开设备管理器" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Click="BtnDevMgr_Click" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2.5*" />
            </Grid.ColumnDefinitions>

            <!-- 设备列表 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="设备" Margin="0,0,10,0"
                                       VerticalAlignment="Center" />
                            <Border Background="#F1F5FB" CornerRadius="6" Padding="7,1" VerticalAlignment="Center"
                                    Margin="0,0,10,0">
                                <TextBlock x:Name="DeviceCountText" FontSize="11.5"
                                           Foreground="{StaticResource SubTextBrush}" />
                            </Border>
                            <ComboBox x:Name="CmbFilter" Width="136" Style="{StaticResource FilterCombo}"
                                      VerticalAlignment="Center" SelectionChanged="CmbFilter_SelectionChanged">
                                <ComboBoxItem Content="全部设备" Tag="all" IsSelected="True" />
                                <ComboBoxItem Content="仅异常设备" Tag="problem" />
                                <ComboBoxItem Content="缺失驱动" Tag="driver" />
                                <ComboBoxItem Content="未连接的设备" Tag="absent" />
                                <ComboBoxItem Content="已忽略的设备" Tag="ignored" />
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SubTitle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="点击一行查看详情" FontSize="11.5" />
                    </Grid>

                    <DataGrid x:Name="DeviceGrid" Grid.Row="1" ItemsSource="{Binding Devices}"
                              RowHeight="38" SelectionChanged="DeviceGrid_SelectionChanged"
                              PreviewMouseLeftButtonDown="DeviceGrid_PreviewMouseLeftButtonDown"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="设备名称" Binding="{Binding FriendlyName}" Width="2.4*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding FriendlyName}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="类别" Binding="{Binding ClassName}" Width="1.05*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="驱动版本" Binding="{Binding DriverVersion}" Width="118">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="状态" Width="92" CellTemplate="{StaticResource StatusCell}" />
                            <DataGridTemplateColumn Header="操作" Width="96" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="查目录" HorizontalAlignment="Center"
                                                    Click="DeviceCatalog_Click"
                                                    ToolTip="按该设备的硬件 ID 检索 Microsoft Update Catalog">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasProblem}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="忽略" HorizontalAlignment="Center" Margin="6,0,0,0"
                                                    Click="DeviceIgnore_Click"
                                                    ToolTip="忽略这个设备的异常提醒，之后可在筛选「已忽略的设备」中恢复">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Ignored}" Value="True">
                                                                <Setter Property="Content" Value="恢复" />
                                                                <Setter Property="ToolTip" Value="恢复这个设备的异常提醒" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasProblem}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 右侧：详情 + 更新 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="DetailCard" Grid.Row="0" Style="{StaticResource Card}" MaxHeight="360">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="设备详情" Margin="0" />
                            <Border x:Name="DetailBadge" Visibility="Collapsed" CornerRadius="9" Padding="8,2"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Background="#FDECEC">
                                <TextBlock x:Name="DetailBadgeText" FontSize="11.5" Foreground="#C62F2F" />
                            </Border>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="DetailPanel">
                                <TextBlock x:Name="DetailEmpty" Style="{StaticResource SubTitle}"
                                           Text="在左侧设备列表中点击一行，这里会显示它的驱动与硬件信息。" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel Margin="0,0,94,0">
                                <TextBlock Style="{StaticResource SectionTitle}" TextWrapping="Wrap" Margin="0,0,0,4"
                                           Text="可用驱动更新（Windows Update 官方源）" />
                                <TextBlock Style="{StaticResource SubTitle}" TextWrapping="Wrap"
                                           Text="由 Windows Update 代理按本机硬件精确匹配，安装后由系统自行校验与回滚。" />
                                <TextBlock x:Name="UpdateHint" Style="{StaticResource SubTitle}" TextWrapping="Wrap"
                                           Margin="0,6,0,0" Foreground="#3B6FD4" />
                            </StackPanel>
                            <Button x:Name="BtnShowIgnoredUpdates" Content="已忽略 0" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Padding="9,4" FontSize="11.5"
                                    Style="{StaticResource GhostButton}" Visibility="Collapsed"
                                    Click="BtnShowIgnoredUpdates_Click"
                                    ToolTip="查看已忽略的驱动更新，可随时恢复" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <DataGrid x:Name="UpdateGrid" ItemsSource="{Binding DriverUpdates}"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      SelectionChanged="UpdateGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="42" CanUserSort="False" CanUserResize="False">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="选择" FontSize="11.5" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource SubTextBrush}" />
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Click="UpdateCheck_Click"
                                                          ToolTip="勾选后点「安装选中」">
                                                    <CheckBox.Style>
                                                        <Style TargetType="CheckBox">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Ignored}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </CheckBox.Style>
                                                </CheckBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="驱动" Binding="{Binding Title}" Width="2.4*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="ToolTip" Value="{Binding Title}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="类别" Binding="{Binding DriverClass}" Width="84">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="ToolTip" Value="{Binding DriverClass}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="版本日期" Binding="{Binding DriverVerDate}" Width="92">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="ToolTip" Value="{Binding DriverVerDate}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 空状态提示 -->
                            <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Margin="0,34,0,0" IsHitTestVisible="False" Visibility="Collapsed">
                                <TextBlock x:Name="EmptyTitle" Text="还没有扫描" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="EmptyDesc" Text="点上方「扫描驱动更新」查询官方驱动" FontSize="11.5" Margin="0,3,0,0"
                                           Foreground="#A6AEBB" HorizontalAlignment="Center" TextWrapping="Wrap"
                                           TextAlignment="Center" MaxWidth="240" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Button x:Name="BtnIgnoreUpdate" Content="忽略此更新" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left" IsEnabled="False" Click="BtnIgnoreUpdate_Click"
                                    Padding="12,7" FontSize="12.5"
                                    ToolTip="选中上方一条驱动更新后，可忽略它；之后在右上角「已忽略」中恢复" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnCheckAll" Content="全选" Style="{StaticResource GhostButton}"
                                        Click="BtnCheckAll_Click" IsEnabled="False"
                                        ToolTip="勾选或取消勾选全部驱动更新" />
                                <Button x:Name="BtnInstallSelected" Content="安装选中" Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0" IsEnabled="False" Click="BtnInstallSelected_Click"
                                        ToolTip="只安装左侧勾选了的驱动更新" />
                                <Button x:Name="BtnInstallAll" Content="安装全部" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        IsEnabled="False" Click="BtnInstallAll_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
