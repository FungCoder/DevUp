<UserControl x:Class="DevUp.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 卡片头：小图标 + 标题 -->
        <Style x:Key="CardIcon" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#EAF1FE" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CardHeading" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="Margin" Value="9,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 小号次要按钮 -->
        <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <!-- 路径值：浅底细框，长路径省略号 -->
        <Style x:Key="PathBox" TargetType="Border">
            <Setter Property="Background" Value="#F7F9FC" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="9,7" />
        </Style>

        <Style x:Key="PathValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#3D4A5C" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="MiniNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#A6AEBB" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="16" />
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
            <Setter Property="Margin" Value="0,14,0,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,0">

            <!-- 第一行：驱动备份（主区域） + 存储位置（侧栏） -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- 备份 -->
                <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource CardIcon}">
                                    <Path Data="M3,3 H11 M3,7 H11 M3,11 H8" Stroke="{StaticResource AccentBrush}"
                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="14" Height="14" Stretch="None" />
                                </Border>
                                <TextBlock Style="{StaticResource CardHeading}" Text="驱动备份与还原" />
                            </StackPanel>

                            <Border Background="#F1F5FB" CornerRadius="7" Padding="8,2" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="BackupCountText" FontSize="11.5" Foreground="{StaticResource SubTextBrush}"
                                           Text="共 0 个备份" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" Style="{StaticResource SubTitle}" TextWrapping="Wrap" Margin="0,8,0,12"
                                   Text="使用系统 pnputil 导出 / 回灌驱动包，格式与 Windows 原生备份一致，可离线还原。" />

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="备份全部驱动" Style="{StaticResource PrimaryButton}" Click="BtnBackupAll_Click" />
                            <Button Content="创建还原点" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Click="BtnRestorePoint_Click" />
                        </StackPanel>

                        <Grid Grid.Row="3">
                            <DataGrid x:Name="BackupGrid" Height="260" RowHeight="38" ItemsSource="{Binding Backups}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="备份名称" Binding="{Binding Name}" Width="2.2*" />
                                    <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="1.3*" />
                                    <DataGridTextColumn Header="驱动包" Binding="{Binding PackageCount}" Width="0.7*" />
                                    <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="0.9*" />
                                    <DataGridTemplateColumn Header="" Width="78" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="还原" Style="{StaticResource MiniButton}"
                                                        Click="BtnRestore_Click" Tag="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 空状态 -->
                            <StackPanel x:Name="BackupEmpty" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        IsHitTestVisible="False" Visibility="Collapsed">
                                <TextBlock Text="还没有驱动备份" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="点「备份全部驱动」把当前系统的第三方驱动包导出到本地"
                                           FontSize="11.5" Margin="0,3,0,0" Foreground="#A6AEBB"
                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="4" Style="{StaticResource MiniNote}" Margin="0,12,0,0"
                                   Text="备份内容为第三方驱动包（pnputil /export-driver），不含 Windows 内置驱动。" />
                    </Grid>
                </Border>

                <!-- 存储位置 -->
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource CardIcon}">
                                <Path Data="M2,4 C2,3.4 2.4,3 3,3 H6 L7.5,4.5 H12 C12.6,4.5 13,4.9 13,5.5 V11 C13,11.6 12.6,12 12,12 H3 C2.4,12 2,11.6 2,11 Z"
                                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1.4" Fill="Transparent"
                                      Width="15" Height="15" Stretch="Uniform" />
                            </Border>
                            <TextBlock Style="{StaticResource CardHeading}" Text="存储位置" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource SubTitle}" TextWrapping="Wrap" Margin="0,8,0,14"
                                   Text="备份与安装包保存的位置，可改到空间更大的磁盘。" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="驱动备份目录" />
                        <Border Style="{StaticResource PathBox}" ToolTip="{Binding Text, ElementName=BackupPathText}">
                            <TextBlock x:Name="BackupPathText" Style="{StaticResource PathValue}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="更改…" Style="{StaticResource MiniButton}" Click="BtnPickBackup_Click" />
                            <Button Content="打开" Style="{StaticResource MiniButton}" Margin="6,0,0,0"
                                    Click="BtnOpenBackup_Click" />
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="下载目录（安装包 / 离线备份）" />
                        <Border Style="{StaticResource PathBox}" ToolTip="{Binding Text, ElementName=DownloadPathText}">
                            <TextBlock x:Name="DownloadPathText" Style="{StaticResource PathValue}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="更改…" Style="{StaticResource MiniButton}" Click="BtnPickDownload_Click" />
                            <Button Content="打开" Style="{StaticResource MiniButton}" Margin="6,0,0,0"
                                    Click="BtnOpenDownload_Click" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource MiniNote}" Margin="0,16,0,0"
                                   Text="更改后立即生效；已存在的备份与安装包不会自动搬移。" />

                        <Border Background="#F7FAFF" BorderBrush="#DCE8FA" BorderThickness="1"
                                CornerRadius="7" Padding="10,8" Margin="0,14,0,0">
                            <TextBlock FontSize="11" Foreground="#5B6B80" TextWrapping="Wrap" LineHeight="16"
                                       Text="驱动备份通常占用数百 MB，建议放在剩余空间充足的磁盘。" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 第二行：启动方式 / 报告导出 / 日志与运行时 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" MinWidth="0" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" MinWidth="0" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" MinWidth="0" />
                </Grid.ColumnDefinitions>

                <!-- 启动方式 -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource CardIcon}">
                                <Path Data="M8,1.4 L13.2,3.6 V7.2 C13.2,10.3 11,12.4 8,13.6 C5,12.4 2.8,10.3 2.8,7.2 V3.6 Z"
                                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1.4" Fill="Transparent"
                                      Width="15" Height="15" Stretch="Uniform" />
                            </Border>
                            <TextBlock Style="{StaticResource CardHeading}" Text="启动方式" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource SubTitle}" TextWrapping="Wrap" Margin="0,8,0,10"
                                   Text="下次启动 DevUp 时使用的权限。" />

                        <ComboBox x:Name="CmbStartup" Style="{StaticResource FilterCombo}"
                                  SelectionChanged="CmbStartup_SelectionChanged">
                            <ComboBoxItem Content="每次询问" Tag="ask" />
                            <ComboBoxItem Content="直接以管理员身份启动" Tag="admin" />
                            <ComboBoxItem Content="以普通权限启动" Tag="normal" />
                        </ComboBox>

                        <TextBlock x:Name="StartupModeHint" Style="{StaticResource MiniNote}" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>

                <!-- 报告导出 -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource CardIcon}">
                                <Path Data="M3.5,1.5 H8.5 L12,5 V13 H3.5 Z M8.5,1.5 V5 H12 M5.5,8 H10 M5.5,10.5 H10"
                                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1.3" Fill="Transparent"
                                      Width="15" Height="15" Stretch="Uniform" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Border>
                            <TextBlock Style="{StaticResource CardHeading}" Text="报告导出" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource SubTitle}" TextWrapping="Wrap" Margin="0,8,0,10"
                                   Text="导出设备状态、驱动包清单与可更新项，便于留档或交接。" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="导出 JSON" Style="{StaticResource MiniButton}" Click="BtnExportJson_Click" />
                            <Button Content="导出 HTML" Style="{StaticResource MiniButton}" Margin="6,0,0,0"
                                    Click="BtnExportHtml_Click" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource MiniNote}" Margin="0,9,0,0"
                                   Text="导出前会让你选择保存位置。" />
                    </StackPanel>
                </Border>

                <!-- 日志与运行时 -->
                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource CardIcon}">
                                <Path Data="M2.5,3 H13.5 V12 H2.5 Z M5,6.5 L6.8,8.2 L5,10 M8.2,10 H11"
                                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1.3" Fill="Transparent"
                                      Width="15" Height="15" Stretch="Uniform" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Border>
                            <TextBlock Style="{StaticResource CardHeading}" Text="日志与运行时" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource SubTitle}" TextWrapping="Wrap" Margin="0,8,0,10"
                                   Text="便携模式：应用数据统一保存在 exe 旁的 DevUpData 文件夹中，内含 data、logs、runtime、temp。目录不可写时会提示错误。" />

                        <Button Content="打开日志目录" Style="{StaticResource MiniButton}" HorizontalAlignment="Left"
                                Click="BtnOpenLog_Click" />

                        <TextBlock Style="{StaticResource MiniNote}" Margin="0,9,0,0"
                                   Text="日志文件：devup.log" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 开源组件 -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="开源组件" Margin="0" />
                        <TextBlock Style="{StaticResource SubTitle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="10.5" Text="遵循各自的开源许可证" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" MinWidth="0" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="11.5" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,5">
                                <Run Text="PSWindowsUpdate" FontWeight="SemiBold" /><Run Text=" (MIT)" FontSize="10.5" Foreground="#9AA5B4" /><Run Text=" — Windows Update 官方 COM 通道" Foreground="{StaticResource SubTextBrush}" />
                            </TextBlock>
                            <TextBlock FontSize="11.5" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,5">
                                <Run Text="Nefarius.Utilities.DeviceManagement" FontWeight="SemiBold" /><Run Text=" (MIT)" FontSize="10.5" Foreground="#9AA5B4" /><Run Text=" — SetupAPI / DriverStore 封装" Foreground="{StaticResource SubTextBrush}" />
                            </TextBlock>
                            <TextBlock FontSize="11.5" LineHeight="18" TextWrapping="Wrap">
                                <Run Text="MSCatalog" FontWeight="SemiBold" /><Run Text=" (MIT)" FontSize="10.5" Foreground="#9AA5B4" /><Run Text=" — Microsoft Update Catalog 检索" Foreground="{StaticResource SubTextBrush}" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock FontSize="11.5" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,5">
                                <Run Text="winget CLI" FontWeight="SemiBold" /><Run Text=" (MIT)" FontSize="10.5" Foreground="#9AA5B4" /><Run Text=" — 微软官方软件源与安装器" Foreground="{StaticResource SubTextBrush}" />
                            </TextBlock>
                            <TextBlock FontSize="11.5" LineHeight="18" TextWrapping="Wrap">
                                <Run Text="pnputil / Checkpoint-Computer" FontWeight="SemiBold" /><Run Text=" — Windows 系统组件" Foreground="{StaticResource SubTextBrush}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
