<Window x:Class="DevUp.Views.StartupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DevUp · 选择启动方式"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="560" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" Background="White"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 权限选项：整块可点，选中时蓝边 + 浅蓝底 + 实心圆点 -->
        <Style x:Key="StartupOption" TargetType="RadioButton">
            <Setter Property="GroupName" Value="StartupMode" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="8" BorderThickness="1" BorderBrush="#E1E7EF"
                                Background="White" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="dot" Width="17" Height="17" CornerRadius="8.5"
                                        BorderBrush="#C3CDDA" BorderThickness="1.5"
                                        VerticalAlignment="Top" Margin="0,2,0,0" Background="White">
                                    <Ellipse x:Name="inner" Width="8" Height="8" Fill="White" />
                                </Border>

                                <ContentPresenter Grid.Column="1" Margin="11,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFD" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#CBD8EC" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F4F8FF" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="dot" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="inner" Property="Fill" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 复选框 -->
        <Style x:Key="StartupCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#4A5563" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="4"
                                    BorderBrush="#C3CDDA" BorderThickness="1.5" Background="White"
                                    VerticalAlignment="Center">
                                <Path x:Name="tick" Data="M1,5 L4,8 L9,1.5" Stroke="White" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Background="White" CornerRadius="10" BorderBrush="#E1E7EF" BorderThickness="1">
        <StackPanel Margin="24,22,24,18">

            <!-- 头部 -->
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="11" Background="#EAF1FE">
                    <Image Source="pack://application:,,,/Assets/app.ico" Width="30" Height="30"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Margin="13,2,0,0" VerticalAlignment="Center">
                    <TextBlock Text="选择启动方式" FontSize="17.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="DevUp · 驱动与软件更新助手" FontSize="11" Foreground="#8A95A5"
                               Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <TextBlock Margin="0,16,0,14" FontSize="12.5" LineHeight="20" TextWrapping="Wrap"
                       Foreground="#4A5563"
                       Text="扫描与安装驱动、创建还原点等系统级操作需要管理员权限。你可以现在决定本次的启动方式，之后可在「备份与工具 → 启动方式」中随时修改。" />

            <!-- 选项 -->
            <RadioButton x:Name="RbAdmin" Style="{StaticResource StartupOption}" IsChecked="True" Margin="0,0,0,9">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="以管理员权限运行" FontSize="13.5" FontWeight="SemiBold" />
                        <Border Background="#EAF1FE" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="推荐" FontSize="10.5" Foreground="{StaticResource AccentDarkBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="可直接扫描并安装 Windows Update 官方驱动、创建系统还原点、启用 Microsoft Update 源。启动时会弹出一次 UAC 确认。"
                               FontSize="11.5" Foreground="#7B8794" TextWrapping="Wrap" LineHeight="17"
                               Margin="0,4,0,0" />
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="RbNormal" Style="{StaticResource StartupOption}">
                <StackPanel>
                    <TextBlock Text="以普通权限运行" FontSize="13.5" FontWeight="SemiBold" />
                    <TextBlock Text="可查看设备与驱动信息、检查并升级 winget 软件。执行驱动安装等需要管理员的操作时，会再单独请求提权。"
                               FontSize="11.5" Foreground="#7B8794" TextWrapping="Wrap" LineHeight="17"
                               Margin="0,4,0,0" />
                </StackPanel>
            </RadioButton>

            <!-- 记住选择 -->
            <StackPanel Orientation="Horizontal" Margin="2,14,0,0">
                <CheckBox x:Name="ChkRemember" Style="{StaticResource StartupCheck}"
                          Content="记住我的选择，下次不再询问" />
                <TextBlock Text="（可随时在设置里改回）" FontSize="11" Foreground="#A6AEBB"
                           VerticalAlignment="Center" Margin="2,0,0,0" />
            </StackPanel>

            <!-- 按钮 -->
            <Grid Margin="0,20,0,0">
                <TextBlock Text="按 Esc 退出" FontSize="11" Foreground="#B3BBC7"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="退出" Style="{StaticResource GhostButton}" MinWidth="76"
                            Click="Exit_Click" />
                    <Button Content="继续" Style="{StaticResource PrimaryButton}" MinWidth="96"
                            Margin="8,0,0,0" IsDefault="True" Click="Continue_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>

