<Window x:Class="DevUp.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DevUp"
        WindowStyle="None" ResizeMode="NoResize" Background="White"
        SizeToContent="Height" Width="470"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <!-- 用 WindowChrome 借系统 DWM 的圆角与投影：既有 ClearType 清晰文字，又有硬件加速 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="White" CornerRadius="10" BorderBrush="#E1E7EF" BorderThickness="1">
        <StackPanel Margin="22,20,22,18">
            <Grid x:Name="HeaderBar" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBox" Width="36" Height="36" CornerRadius="9" Background="{StaticResource AccentBrush}"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="IconGlyph" Text="i" Foreground="White" FontSize="19" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock x:Name="TitleText" Grid.Column="1" Margin="14,6,0,0" FontSize="15.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
            </Grid>

            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" Margin="50,10,0,0"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="MessageText" FontSize="13" LineHeight="21" TextWrapping="Wrap"
                           Foreground="#3E4C5B" />
            </ScrollViewer>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="BtnExtra" Content="" Style="{StaticResource GhostButton}"
                        Margin="0,0,8,0" Visibility="Collapsed" Click="Extra_Click" />
                <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource GhostButton}"
                        Margin="0,0,8,0" Visibility="Collapsed" Click="Cancel_Click" />
                <Button x:Name="BtnOk" Content="确定" Style="{StaticResource PrimaryButton}"
                        MinWidth="88" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
