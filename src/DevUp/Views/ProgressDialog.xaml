<Window x:Class="DevUp.Views.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DevUp"
        WindowStyle="None" ResizeMode="NoResize" Background="White"
        SizeToContent="Height" Width="470"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <!-- 与 MessageDialog 一致：用 WindowChrome 借系统 DWM 的圆角与投影，文字保持 ClearType 清晰 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="White" CornerRadius="10" BorderBrush="#E1E7EF" BorderThickness="1">
        <StackPanel Margin="24,22,24,20">
            <TextBlock x:Name="TitleText" FontSize="15.5" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />

            <TextBlock x:Name="StatusText" Margin="0,8,0,0" FontSize="13" Foreground="#3E4C5B"
                       TextWrapping="Wrap" />

            <Grid Margin="0,16,0,0">
                <Border x:Name="BarTrack" Height="8" CornerRadius="4" Background="#E9EEF5" />
                <Border x:Name="BarFill" Height="8" CornerRadius="4" HorizontalAlignment="Left"
                        Background="{StaticResource AccentBrush}" Width="0" />
                <ProgressBar x:Name="IndeterminateBar" Height="8" BorderThickness="0"
                             Background="Transparent" Foreground="{StaticResource AccentBrush}"
                             IsIndeterminate="True" Visibility="Collapsed" />
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DetailText" Grid.Column="0" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="PercentText" Grid.Column="1" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <!-- 已用时间单独占右侧一格：与详情文字分开，避免两处互相覆盖导致闪烁 -->
                <TextBlock x:Name="ElapsedText" Grid.Column="1" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="NoWrap" Visibility="Collapsed" />
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
