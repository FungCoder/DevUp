<UserControl x:Class="DevUp.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="管理系统与软件的自启动入口" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="SummaryText" Text="扫描后查看真实系统配置；禁用前保存恢复信息。"
                               TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" />
                </StackPanel>
                <Button x:Name="ScanButton" Grid.Column="1" Content="扫描 / 刷新" Click="Scan_Click"
                        Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBox x:Name="SearchBox" Width="240" VerticalContentAlignment="Center" Padding="10,6"
                     TextChanged="Filter_Changed" ToolTip="搜索名称、启动命令或位置" AutomationProperties.Name="搜索自启项" />
            <ComboBox x:Name="SourceFilter" Width="160" Margin="10,0,0,0" SelectedIndex="0"
                      Style="{StaticResource FilterCombo}" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="应用启动入口" Tag="apps" />
                <ComboBoxItem Content="Windows 服务" Tag="services" />
                <ComboBoxItem Content="全部来源" Tag="all" />
            </ComboBox>
            <CheckBox x:Name="ShowSystem" Content="显示受保护系统项" Margin="16,0,0,0" VerticalAlignment="Center"
                      Checked="Filter_Changed" Unchecked="Filter_Changed" />
        </WrapPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="10">
                <DataGrid x:Name="EntryGrid" SelectionMode="Extended" SelectionChanged="Selection_Changed"
                          AutomationProperties.Name="自启动入口列表">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="90" />
                        <DataGridTextColumn Header="来源" Binding="{Binding SourceText}" Width="145" />
                        <DataGridTextColumn Header="范围" Binding="{Binding ScopeText}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="启动入口明细" Style="{StaticResource SectionTitle}" />
                    <TextBox x:Name="DetailsText" Grid.Row="1" Text="选择入口查看来源、命令与影响。"
                             IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                             VerticalScrollBarVisibility="Auto" Padding="0" />
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <WrapPanel Margin="0,2,0,8">
                <Button x:Name="DisableButton" Content="禁用选中入口" Click="Disable_Click" IsEnabled="False"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" />
                <Button x:Name="RelatedButton" Content="禁用同一程序的关联入口" Click="Related_Click" IsEnabled="False"
                        Style="{StaticResource GhostButton}" Margin="0,0,8,6" />
                <Button x:Name="RestoreButton" Content="恢复选中入口" Click="Restore_Click" IsEnabled="False"
                        Style="{StaticResource GhostButton}" Margin="0,0,0,6" />
            </WrapPanel>
            <TextBlock x:Name="ResultText" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" />
            <Expander x:Name="WarningsPanel" Header="扫描限制与未读取项目" Visibility="Collapsed" Margin="0,6,0,0">
                <ScrollViewer MaxHeight="120"><TextBlock x:Name="WarningsText" TextWrapping="Wrap" /></ScrollViewer>
            </Expander>
            <TextBlock Text="Ctrl / Shift 可多选。禁用影响后续启动，不结束当前进程。恢复仅用于 DevUp 保存的原配置。Store 应用、策略及软件自我修复可能有其他启动入口；复核通过表示当前配置已禁用，实际重启效果仍需验证。"
                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
