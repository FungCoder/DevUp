<UserControl x:Class="DevUp.Views.SoftwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 状态标签：可更新=蓝，已是最新=绿，未匹配=灰 -->
        <DataTemplate x:Key="SoftStatusCell">
            <Border x:Name="pill" CornerRadius="9" Padding="8,2" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Background="#F1F3F7">
                <TextBlock x:Name="txt" Text="未匹配" FontSize="11.5" Foreground="#7B8794" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasWingetMatch}" Value="True">
                    <Setter TargetName="pill" Property="Background" Value="#EAF8EF" />
                    <Setter TargetName="txt" Property="Foreground" Value="#15803D" />
                    <Setter TargetName="txt" Property="Text" Value="已是最新" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                    <Setter TargetName="pill" Property="Background" Value="#EAF1FE" />
                    <Setter TargetName="txt" Property="Foreground" Value="#2D6CDF" />
                    <Setter TargetName="txt" Property="Text" Value="可更新" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Ignored}" Value="True">
                    <Setter TargetName="pill" Property="Background" Value="#F1F3F7" />
                    <Setter TargetName="txt" Property="Foreground" Value="#7B8794" />
                    <Setter TargetName="txt" Property="Text" Value="已忽略" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="HashText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#4A5568" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="14" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarSurface}">
            <StackPanel Orientation="Horizontal">
                <Button Content="刷新已装清单" Style="{StaticResource GhostButton}" Click="BtnRefresh_Click" />
                <Button Content="检查更新（winget）" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                        Click="BtnCheck_Click" />
                <Button Content="全部升级" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Click="BtnUpgradeAll_Click" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2.6*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：软件列表 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="软件" Margin="0,0,10,0"
                                       VerticalAlignment="Center" />
                            <Border Background="#F1F5FB" CornerRadius="6" Padding="7,1" VerticalAlignment="Center"
                                    Margin="0,0,10,0">
                                <TextBlock x:Name="SoftCountText" FontSize="11.5"
                                           Foreground="{StaticResource SubTextBrush}" />
                            </Border>
                            <ComboBox x:Name="CmbFilter" Width="126" Style="{StaticResource FilterCombo}"
                                      VerticalAlignment="Center" SelectionChanged="CmbFilter_SelectionChanged">
                                <ComboBoxItem Content="全部软件" Tag="all" IsSelected="True" />
                                <ComboBoxItem Content="仅可更新" Tag="updates" />
                                <ComboBoxItem Content="已忽略" Tag="ignored" />
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SubTitle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="点击一行查看详情" FontSize="11.5" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <DataGrid x:Name="SoftwareGrid" ItemsSource="{Binding Software}" RowHeight="40"
                                  SelectionMode="Single" SelectionChanged="SoftwareGrid_SelectionChanged"
                                  PreviewMouseLeftButtonDown="SoftwareGrid_PreviewMouseLeftButtonDown"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="软件名称" Binding="{Binding DisplayName}" Width="2.2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding DisplayName}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="已安装" Binding="{Binding DisplayVersion}" Width="112">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding DisplayVersion}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="可用" Binding="{Binding AvailableVersion}" Width="112">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding AvailableVersion}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                    <Setter Property="Foreground" Value="#2D6CDF" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="状态" Width="92" CanUserSort="False"
                                                        CellTemplate="{StaticResource SoftStatusCell}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 空状态 -->
                        <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Margin="0,30,0,0" IsHitTestVisible="False" Visibility="Collapsed">
                            <TextBlock x:Name="EmptyTitle" Text="还没有软件清单" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyDesc" Text="点上方「刷新已装清单」读取桌面软件与 MSIX 应用"
                                       FontSize="11.5" Margin="0,3,0,0" Foreground="#A6AEBB" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="260" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="SoftHint" Grid.Row="2" Style="{StaticResource SubTitle}" Margin="0,10,0,0"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <!-- 右侧：详情 + 更新说明与校验 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" MaxHeight="380">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="软件详情" Margin="0" />
                            <Border x:Name="DetailBadge" Visibility="Collapsed" CornerRadius="9" Padding="8,2"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EAF1FE">
                                <TextBlock x:Name="DetailBadgeText" FontSize="11.5" Foreground="#2D6CDF" />
                            </Border>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock x:Name="DetailEmpty" Style="{StaticResource SubTitle}" TextWrapping="Wrap"
                                           Text="在左侧点击一个软件，这里会显示版本、官方元数据与安装包校验结果。" />

                                <StackPanel x:Name="DetailBody" Visibility="Collapsed">
                                    <TextBlock x:Name="DetailName" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DetailMeta" FontSize="11.5" Margin="0,3,0,12"
                                               Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" />

                                    <TextBlock Style="{StaticResource DetailLabel}" Text="已安装版本" />
                                    <TextBlock x:Name="DetailInstalled" Style="{StaticResource DetailValue}" />

                                    <TextBlock Style="{StaticResource DetailLabel}" Text="可用版本" />
                                    <TextBlock x:Name="DetailAvailable" Style="{StaticResource DetailValue}" />

                                    <TextBlock Style="{StaticResource DetailLabel}" Text="winget 包 ID" />
                                    <TextBlock x:Name="DetailId" Style="{StaticResource DetailValue}" />

                                    <TextBlock Style="{StaticResource DetailLabel}" Text="安装包类型 / 发布日期" />
                                    <TextBlock x:Name="DetailTypeDate" Style="{StaticResource DetailValue}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel x:Name="DetailActions" Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0"
                                    Visibility="Collapsed">
                            <Button x:Name="BtnUpgradeThis" Content="升级到此版本" Style="{StaticResource PrimaryButton}"
                                    IsEnabled="False" Click="BtnUpgradeThis_Click" />
                            <Button x:Name="BtnDownloadThis" Content="下载安装包" Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0" IsEnabled="False" Click="BtnDownloadThis_Click"
                                    ToolTip="保存到「下载目录」，并自动计算 MD5 / SHA256" />
                            <Button x:Name="BtnIgnoreThis" Content="忽略此更新" Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0" Padding="12,7" FontSize="12.5" Visibility="Collapsed"
                                    Click="BtnIgnoreThis_Click"
                                    ToolTip="忽略后可在筛选「已忽略」中查询并恢复" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="更新说明与校验" Margin="0,0,0,2" />
                            <TextBlock Style="{StaticResource SubTitle}" TextWrapping="Wrap" FontSize="11.5"
                                       Text="SHA256 取自 winget 官方清单；升级时 winget 会先校验安装包再安装。" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock x:Name="InfoLoading" Style="{StaticResource SubTitle}" TextWrapping="Wrap"
                                           Visibility="Collapsed" Text="正在读取 winget 官方清单…" />

                                <TextBlock x:Name="InfoError" FontSize="11.5" Foreground="#C62F2F" TextWrapping="Wrap"
                                           Visibility="Collapsed" />

                                <TextBlock x:Name="InfoEmpty" Style="{StaticResource SubTitle}" TextWrapping="Wrap"
                                           Text="这里会显示所选版本的更新内容、官方下载地址与 SHA256 校验值。" />

                                <StackPanel x:Name="InfoBody" Visibility="Collapsed">
                                    <TextBlock x:Name="ReleaseMeta" FontSize="11.5" Foreground="{StaticResource SubTextBrush}"
                                               TextWrapping="Wrap" Margin="0,0,0,4" />

                                    <TextBlock Style="{StaticResource DetailLabel}" Text="官方 SHA256（winget 清单）"
                                               Margin="0,6,0,4" />
                                    <TextBlock x:Name="OfficialSha" Style="{StaticResource HashText}" />
                                    <TextBlock x:Name="OfficialShaMissing" FontSize="11.5" Foreground="#A26A00"
                                               TextWrapping="Wrap" Visibility="Collapsed"
                                               Text="该软件未在清单中提供 SHA256，无法自动比对；可打开官方下载页人工核对。" />
                                    <Button x:Name="BtnCopySha" Content="复制 SHA256" Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,4"
                                            Visibility="Collapsed" Click="BtnCopySha_Click" />

                                    <TextBlock Style="{StaticResource DetailLabel}" Text="安装包校验"
                                               Margin="0,12,0,4" />
                                    <Button x:Name="BtnVerify" Content="下载并校验安装包" Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Left" Padding="12,5" Click="BtnVerify_Click"
                                            ToolTip="下载官方安装包，计算本地 MD5 / SHA256，并与上面的官方值比对" />

                                    <Border x:Name="VerifyBadge" Visibility="Collapsed" CornerRadius="9" Padding="8,2"
                                            HorizontalAlignment="Left" Margin="0,8,0,0" Background="#F1F3F7">
                                        <TextBlock x:Name="VerifyBadgeText" FontSize="11.5" Foreground="#7B8794" />
                                    </Border>

                                    <StackPanel x:Name="LocalHashes" Visibility="Collapsed" Margin="0,8,0,0">
                                        <TextBlock Style="{StaticResource DetailLabel}" Text="本地 MD5" Margin="0,0,0,2" />
                                        <TextBlock x:Name="LocalMd5" Style="{StaticResource HashText}" />
                                        <TextBlock Style="{StaticResource DetailLabel}" Text="本地 SHA256" Margin="0,8,0,2" />
                                        <TextBlock x:Name="LocalSha" Style="{StaticResource HashText}" />
                                        <TextBlock x:Name="LocalFile" FontSize="11" Foreground="#A6AEBB" TextWrapping="Wrap"
                                                   Margin="0,6,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="复制 MD5" Style="{StaticResource GhostButton}" Padding="10,4"
                                                    Click="BtnCopyMd5_Click" />
                                            <Button Content="复制 SHA256" Style="{StaticResource GhostButton}"
                                                    Margin="8,0,0,0" Padding="10,4" Click="BtnCopyLocalSha_Click" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock x:Name="VerifyNote" FontSize="11" Foreground="{StaticResource SubTextBrush}"
                                               TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="16" />

                                    <Button x:Name="BtnInstallerUrl" Content="打开官方下载地址"
                                            Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                            Margin="0,10,0,0" Padding="10,4" Visibility="Collapsed"
                                            Click="BtnInstallerUrl_Click" />

                                    <Border Height="1" Background="#EEF1F6" Margin="0,12,0,10" />

                                    <TextBlock Text="更新说明" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />
                                    <TextBlock x:Name="ReleaseNotes" FontSize="12" Foreground="{StaticResource TextBrush}"
                                               TextWrapping="Wrap" LineHeight="19" />
                                    <Button x:Name="BtnReleaseNotes" Content="打开官方发布说明" Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,4"
                                            Visibility="Collapsed" Click="BtnReleaseNotes_Click" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
